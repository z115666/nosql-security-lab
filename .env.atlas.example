# Plantilla para la extensión cloud (scripts/05_atlas.sh). Copia a .env.atlas y rellena.
# .env.atlas NO se sube a Git (está en .gitignore).
# ATLAS_HOST: la parte del connection string tras la @, p. ej. cluster0.abcd123.mongodb.net
ATLAS_HOST=cluster0.xxxxxxx.mongodb.net
ATLAS_USER=app_tienda
# Usa la contraseña autogenerada por Atlas (alfanumérica, sin caracteres que haya que codificar)
ATLAS_PASSWORD=cambiar
